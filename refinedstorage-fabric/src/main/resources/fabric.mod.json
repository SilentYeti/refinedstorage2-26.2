{
  "schemaVersion": 1,
  "id": "refinedstorage",
  "version": "${version}",
  "name": "Refined Storage: Community Edition",
  "description": "Refined Storage: Community Edition is a community-maintained fork of Refined Storage, a mass storage mod for Minecraft that offers the player a network-based storage system, allowing them to store items and fluids on a massively expandable device network. Not affiliated with Refined Mods.",
  "authors": [
    "Refined Mods"
  ],
  "contact": {
    "sources": "https://github.com/SilentYeti/refinedstorage2-26.2",
    "issues": "https://github.com/SilentYeti/refinedstorage2-26.2/issues",
    "homepage": "https://refinedmods.com/refined-storage"
  },
  "accessWidener": "refinedstorage.accesswidener",
  "icon": "assets/refinedstorage/icon.png",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.refinedmods.refinedstorage.fabric.ModInitializerImpl"
    ],
    "client": [
      "com.refinedmods.refinedstorage.fabric.ClientModInitializerImpl"
    ],
    "modmenu": [
      "com.refinedmods.refinedstorage.fabric.modmenu.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "refinedstorage.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25",
    "cloth-config2": "*",
    "team_reborn_energy": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
